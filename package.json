{
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "d3-geo": "^3.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "three": "^0.186.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "vite": "^8.3.0"
  },
  "name": "oceanembed",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/dashboard/*.test.js",
    "format": "prettier --write dashboard/index.html architecture/index.html \"src/dashboard/**/*.{js,css}\" \"src/architecture/**/*.{js,css}\" vite.config.js package.json",
    "format:check": "prettier --check dashboard/index.html architecture/index.html \"src/dashboard/**/*.{js,css}\" \"src/architecture/**/*.{js,css}\" vite.config.js package.json"
  }
}
